# Copia este archivo como ".env" (sin el ".example") y rellena tus valores reales.
# El archivo ".env" nunca se sube a git (mira .gitignore).

# Token de Travelpayouts Data API:
# https://www.travelpayouts.com/ -> perfil -> "API token"
TRAVELPAYOUTS_TOKEN=

# Token del bot de Telegram, lo da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# ID numerico del chat/usuario al que el bot enviara los avisos
TELEGRAM_CHAT_ID=

# API key de Gemini (aistudio.google.com/apikey), usada para juzgar si un precio es un chollo
GEMINI_API_KEY=

# Solo hacen falta estas dos para el panel local (python -m flight_hunter.web),
# NO se usan en GitHub Actions ni hace falta subirlas como secrets del repo.
# GITHUB_TOKEN: fine-grained personal access token con permiso "Actions: Read and write"
#   sobre este repo -> github.com/settings/personal-access-tokens
# GITHUB_REPO: "usuario/nombre-del-repo"
GITHUB_TOKEN=
GITHUB_REPO=juancarlostorrecillacastro-blip/cazador-vuelos
